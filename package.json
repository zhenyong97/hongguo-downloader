{
  "name": "hongguo-downloader",
  "version": "1.1.0",
  "description": "Trình tải hàng loạt toàn bộ tập phim ngắn Hongguo (bản Windows)",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder --win",
    "build:zip": "npm run build:react && electron-builder --win --dir && node scripts/make-zip.js",
    "build:dir": "npm run build:react && electron-builder --win --dir",
    "build:portable": "npm run build:react && electron-builder --win portable",
    "build:installer": "npm run build:react && electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "zip": "node scripts/make-zip.js"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hongguo.downloader",
    "productName": "TrinhTaiPhimNganHongguo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "*.txt",
          "COPYING.*",
          "LICENSE.md"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName}-${version}-BanDiDong.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trình tải phim ngắn Hongguo",
      "uninstallDisplayName": "Trình tải phim ngắn Hongguo",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
