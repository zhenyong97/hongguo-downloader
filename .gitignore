# Thư viện phụ thuộc
node_modules/
dist/
dist-react/

# File nhị phân ffmpeg tích hợp (khoảng 167MB, tải từ mạng, không đưa vào quản lý phiên bản)
# Trước khi đóng gói chạy: node scripts/setup-ffmpeg.js hoặc tự đặt vào build/ffmpeg/
# Lưu ý: văn bản giấy phép (*.txt / COPYING.* / LICENSE.md) bắt buộc phải giữ cùng mã nguồn,
#       vì vậy ở đây chỉ bỏ qua nội dung thư mục, rồi dùng quy tắc phủ định để đưa chúng vào lại.
build/ffmpeg/*
!build/ffmpeg/*.txt
!build/ffmpeg/COPYING.*
!build/ffmpeg/LICENSE.md

# Đầu ra build và đóng gói
release/
out/
.webpack/
*.asar
*.exe
*.dmg
*.app
*.AppImage

# File tạm và cache
.zcode/
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
*.tmp
.cache/
.npm-cache/
.electron-cache/
.eb-cache/

# Cấu hình cục bộ
config.json
settings.json
